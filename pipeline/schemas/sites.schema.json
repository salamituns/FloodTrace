{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodtrace.local/pipeline/schemas/sites.schema.json",
  "title": "FloodTrace events/sites.json",
  "description": "Built by pipeline/build_sites.py (Task 23, docs/SITES_PLAN.md). Never hand-edited except for the reviewer fields: verdict and change.summary.",
  "type": "object",
  "required": [
    "meta",
    "sites"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object"
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/site"
      }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "required": [
        "site_id",
        "name",
        "aliases",
        "structure_name",
        "structure_type",
        "geometry",
        "location_confidence",
        "located_how",
        "flood_radius_m",
        "floods",
        "catalog_floods",
        "catalog_summary",
        "claims",
        "change",
        "promise_ids",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "site_id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Short human name, e.g. 'Alpha Beach – System 156'."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "location_names of matched evidence features."
        },
        "structure_name": {
          "type": "string"
        },
        "structure_type": {
          "enum": [
            "channel",
            "collector",
            "canal",
            "bridge",
            "road",
            "area"
          ]
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "location_confidence": {
          "type": "string"
        },
        "located_how": {
          "type": "string"
        },
        "flood_radius_m": {
          "type": "number",
          "description": "Match radius for floods/claims: 400 m, or 600 m for LineStrings longer than 2 km."
        },
        "floods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flood"
          }
        },
        "catalog_floods": {
          "type": "array",
          "description": "Task 29: catalog flood days (events/flood_days.json) matched to this site, newest first.",
          "items": {
            "$ref": "#/$defs/catalog_flood"
          }
        },
        "catalog_summary": {
          "$ref": "#/$defs/catalog_summary"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "change": {
          "$ref": "#/$defs/change"
        },
        "promise_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verdict": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/verdict"
            }
          ]
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Point",
            "LineString"
          ]
        },
        "coordinates": {
          "type": "array"
        }
      }
    },
    "flood": {
      "type": "object",
      "required": [
        "event_id",
        "date",
        "evidence_ids",
        "n_reports",
        "nearest_m"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "description": "Event date (events/catalog.json)."
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "n_reports": {
          "type": "integer"
        },
        "nearest_m": {
          "type": "number",
          "description": "Distance from the site geometry to the nearest matched evidence point."
        }
      }
    },
    "catalog_flood": {
      "type": "object",
      "description": "Task 29: one catalog flood day matched to this site.",
      "required": [
        "date",
        "flood_type",
        "episode_id",
        "strength",
        "matched_areas",
        "distance_m",
        "n_outlets",
        "promote",
        "tier_a_event_id",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "description": "Catalog flood day (events/flood_days.json)."
        },
        "flood_type": {
          "enum": [
            "pluvial",
            "riverine",
            "lagoon",
            "coastal"
          ]
        },
        "episode_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "strength": {
          "enum": [
            "name",
            "near",
            "area"
          ],
          "description": "name: place token in an area name; near: exact/street-confidence area within flood_radius_m + 200 m; area: neighbourhood/area-confidence area within 1,500 m."
        },
        "matched_areas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Area names that established the recorded strength."
        },
        "distance_m": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ],
          "description": "Distance to the nearest matched area with coordinates; null when none geocoded."
        },
        "n_outlets": {
          "type": "integer"
        },
        "promote": {
          "type": "boolean"
        },
        "tier_a_event_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "sources": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/catalog_source"
          }
        }
      }
    },
    "catalog_source": {
      "type": "object",
      "required": [
        "url",
        "publisher",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "publisher": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "quote": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "catalog_summary": {
      "type": "object",
      "description": "Task 29: per-site counts, honest about how hard each year was searched.",
      "required": [
        "n_days",
        "n_days_strong",
        "years_with_flood",
        "years_searched",
        "per_searched_year",
        "riverine_days",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "n_days": {
          "type": "integer"
        },
        "n_days_strong": {
          "type": "integer",
          "description": "Days matched at strength name or near."
        },
        "years_with_flood": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "years_searched": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Years with an April-November entry in flood_days.json meta.search_coverage."
        },
        "per_searched_year": {
          "type": "number",
          "description": "n_days_strong / len(years_searched), 2 decimals."
        },
        "riverine_days": {
          "type": "integer",
          "description": "Matched days whose flood_type is riverine."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "event_id",
        "cause",
        "attributed_by",
        "who",
        "quote",
        "source_id",
        "url",
        "date",
        "evidence_status",
        "status_note"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string",
          "description": "<site_id>-<event_id>-<evidence_id>; evidence ids are unique per event only."
        },
        "event_id": {
          "type": "string"
        },
        "cause": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "attributed_by": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "who": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "quote": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "source_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "date": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "evidence_status": {
          "enum": [
            "supports",
            "weak",
            "inconclusive",
            "contradicts",
            "not_checked",
            "no_imagery_after"
          ]
        },
        "status_note": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "change": {
      "type": "object",
      "required": [
        "wayback",
        "s2_wet_season",
        "buildings_0_10m",
        "summary",
        "stale"
      ],
      "additionalProperties": false,
      "properties": {
        "wayback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wayback_image"
          }
        },
        "s2_wet_season": {
          "type": "object",
          "required": [
            "aoi",
            "by_year"
          ],
          "additionalProperties": false,
          "properties": {
            "aoi": {
              "type": "string",
              "description": "AOI used from drainage_sites_s2.json (alpha-beach-156 uses the __south AOI)."
            },
            "by_year": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "description": "May–Oct median vegfrac per year."
            }
          }
        },
        "buildings_0_10m": {
          "type": "object",
          "required": [
            "by_year",
            "matched_pct",
            "matched_n",
            "excluded"
          ],
          "additionalProperties": false,
          "properties": {
            "by_year": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "description": "Built fraction 0–10 m from the channel, 2016–2023."
            },
            "matched_pct": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer"
                }
              ],
              "description": "Percent of matched baseline segments whose 2016→2023 change is below the site's."
            },
            "matched_n": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "excluded": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            }
          }
        },
        "summary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "One sentence, written by a reviewer."
        },
        "stale": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ],
          "description": "True when the numbers under the summary changed since it was written; null when there is no summary."
        }
      }
    },
    "wayback_bounds": {
      "type": "object",
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "additionalProperties": false,
      "properties": {
        "west": { "type": "number" },
        "south": { "type": "number" },
        "east": { "type": "number" },
        "north": { "type": "number" }
      },
      "description": "Lon/lat box of the north-up web-mercator chip crop."
    },
    "wayback_image": {
      "type": "object",
      "required": [
        "acq_date",
        "release",
        "zoom",
        "tile_url",
        "bounds",
        "resolution_m",
        "detail_chips"
      ],
      "additionalProperties": false,
      "properties": {
        "acq_date": {
          "type": "string"
        },
        "release": {
          "type": "integer",
          "description": "Esri Wayback release number used for the live tiles."
        },
        "zoom": {
          "type": "integer"
        },
        "tile_url": {
          "type": "string",
          "description": "WMTS template with {level}/{row}/{col} (and the release in the path)."
        },
        "bounds": {
          "$ref": "#/$defs/wayback_bounds"
        },
        "resolution_m": {
          "type": "number",
          "description": "Source imagery resolution; the app hides coarse fallbacks (e.g. 15 m)."
        },
        "detail_chips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detail_chip"
          }
        }
      }
    },
    "detail_chip": {
      "type": "object",
      "required": [
        "station",
        "release",
        "zoom",
        "tile_url",
        "bounds",
        "resolution_m"
      ],
      "additionalProperties": false,
      "properties": {
        "station": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "release": { "type": "integer" },
        "zoom": { "type": "integer" },
        "tile_url": { "type": "string" },
        "bounds": { "$ref": "#/$defs/wayback_bounds" },
        "lon": { "type": "number" },
        "lat": { "type": "number" },
        "resolution_m": {
          "type": "number",
          "description": "Inherited from the parent acquisition (chips are crops of the same image)."
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "text",
        "confidence",
        "reviewed_by",
        "reviewed_at",
        "stale"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "strong",
            "moderate",
            "weak",
            "none"
          ]
        },
        "reviewed_by": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string"
        },
        "stale": {
          "type": "boolean",
          "description": "True when the numbers under this verdict changed since it was written."
        }
      }
    }
  }
}
