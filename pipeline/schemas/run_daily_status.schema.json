{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodtrace.local/pipeline/schemas/run_daily_status.schema.json",
  "title": "FloodTrace events/forecast/status.json",
  "description": "Written by pipeline/run_daily.py (Task 45, docs/tasks/45-daily-run.md) after every daily run. Never hand-edited. Says when the run happened, whether each step was ok, skipped or failed, the last day the IMERG satellite history covers (imerg_through), and how many forecast cell-days have been scored (n_scored, from scores.json).",
  "type": "object",
  "required": ["meta", "last_run", "ok", "steps", "imerg_through", "n_scored"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["built_by", "task", "schema", "generated_at"],
      "additionalProperties": false,
      "properties": {
        "built_by": { "const": "pipeline/run_daily.py" },
        "task": { "const": "45-daily-run (docs/tasks/45-daily-run.md)" },
        "schema": { "const": "pipeline/schemas/run_daily_status.schema.json" },
        "generated_at": { "$ref": "#/$defs/timestamp_utc" }
      }
    },
    "last_run": { "$ref": "#/$defs/timestamp_lagos" },
    "ok": {
      "type": "boolean",
      "description": "true when no step failed (skipped steps do not count as failures)"
    },
    "steps": {
      "type": "object",
      "required": ["forecast", "imerg", "score_forecasts"],
      "additionalProperties": false,
      "properties": {
        "forecast": { "$ref": "#/$defs/step" },
        "imerg": { "$ref": "#/$defs/step" },
        "score_forecasts": { "$ref": "#/$defs/step" }
      }
    },
    "imerg_through": {
      "type": ["string", "null"],
      "description": "last Africa/Lagos day the IMERG grid history has a value for, after this run's steps",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "n_scored": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "scored forecast cell-days, from events/forecast/scores.json; null while that file does not exist"
    }
  },
  "$defs": {
    "timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$"
    },
    "timestamp_lagos": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+01:00$"
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "started_at", "finished_at", "exit_code", "seconds"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["ok", "failed"] },
            "started_at": { "$ref": "#/$defs/timestamp_lagos" },
            "finished_at": { "$ref": "#/$defs/timestamp_lagos" },
            "exit_code": { "type": "integer" },
            "seconds": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["status", "at", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "skipped" },
            "at": { "$ref": "#/$defs/timestamp_lagos" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
